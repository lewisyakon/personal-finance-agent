APP_MODE=local
DEVELOPER_ENABLED=true
# 留空时 DATABASE_URL 固定派生为 DATA_DIR/personal_finance.db。
# DATABASE_URL=sqlite:////absolute/path/to/personal_finance.db
DATA_DIR=./data
APP_TIMEZONE=Asia/Shanghai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_CONTEXT_CHARS=131072
LLM_INPUT_COST_PER_MILLION_MICROUSD=0
LLM_OUTPUT_COST_PER_MILLION_MICROUSD=0
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RESULT_BYTES=524288
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_MODEL_CALLS=8
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_MAX_TOTAL_TOKENS=32000
AGENT_MAX_REPLANS=1
AGENT_MAX_COST_MICROUSD=100000
PLANNER_PARALLEL_WORKERS=4
SEMANTIC_AUTO_APPLY_THRESHOLD=0.85
SEMANTIC_MAX_CATEGORIES=100
RAW_FILE_TTL_MINUTES=60
FINGERPRINT_SECRET=replace-with-a-local-secret
MAX_UPLOAD_BYTES=20971520
ARCHIVE_MAX_ENTRIES=2000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=104857600
ARCHIVE_MAX_ENTRY_BYTES=26214400
ARCHIVE_MAX_COMPRESSION_RATIO=200
DATA_EXPORT_MAX_BYTES=52428800
BACKUP_MAX_BYTES=2147483648
DATA_CONFIRMATION_TTL_SECONDS=300
LOCAL_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],testserver
LOCAL_OWNER_ID=local-owner

# Optional Docker build tuning. These do not change the runtime network.
# PFA_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PFA_BUILD_NETWORK=host
